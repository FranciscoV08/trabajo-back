<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CoderHouse Proyectos</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .products-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 20px; padding: 20px; }
        .product-card { border: 1px solid #ddd; padding: 15px; border-radius: 8px; box-shadow: 2px 2px 5px rgba(0,0,0,0.1); }
        .price { font-weight: bold; color: #2c3e50; font-size: 1.2em; }
        .pagination { margin: 20px; text-align: center; }
        .btn-page { padding: 5px 10px; background: #3498db; color: white; text-decoration: none; border-radius: 4px; }
        .btn-add { background: #27ae60; color: white; border: none; padding: 8px 12px; cursor: pointer; border-radius: 4px; }
        .btn-detail { background: #34495e; color: white; padding: 8px 12px; text-decoration: none; border-radius: 4px; display: inline-block; }
        nav a { margin-right: 15px; text-decoration: none; color: #333; font-weight: bold; }
        header { background: #f8f9fa; padding: 15px; border-bottom: 1px solid #dee2e6; }
        .cart-item { display: flex; justify-content: space-between; border-bottom: 1px solid #eee; padding: 10px 0; }
    </style>
</head>
<body>
    <header>
        <nav>
            <a href="/">Home</a>
            <a href="/products">Productos</a>
            <a href="/realtimeproducts">Real Time</a>
            <a href="#" id="view-cart">Mi Carrito</a>
        </nav>
    </header>
    
    <main>
        {{{body}}}
    </main>

    <footer>
        <p>&copy; 2024 Backend CoderHouse</p>
    </footer>

    <script>
        document.getElementById('view-cart').addEventListener('click', (e) => {
            e.preventDefault();
            const cartId = localStorage.getItem('cartId');
            if (cartId) {
                window.location.href = `/carts/${cartId}`;
            } else {
                alert('No tienes un carrito activo. Agrega productos para crear uno.');
            }
        });
    </script>
</body>
</html>
