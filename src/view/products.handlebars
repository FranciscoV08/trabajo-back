<div class="products-container">
    <h1>Lista de Productos</h1>
    
    <div class="filters">
        <form action="/products" method="GET">
            <input type="text" name="query" placeholder="Categoría..." value="{{query}}">
            <select name="sort">
                <option value="">Sin orden</option>
                <option value="asc">Precio: Menor a Mayor</option>
                <option value="desc">Precio: Mayor a Menor</option>
            </select>
            <button type="submit">Filtrar</button>
        </form>
    </div>

    <div class="products-grid">
        {{#each products}}
            <div class="product-card">
                <h3>{{this.title}}</h3>
                <p>{{this.description}}</p>
                <p>Categoría: {{this.category}}</p>
                <p class="price">${{this.price}}</p>
                <div class="actions">
                    <a href="/products/{{this._id}}" class="btn-detail">Ver detalles</a>
                    <button class="btn-add" onclick="addToCart('{{this._id}}')">Agregar al carrito</button>
                </div>
            </div>
        {{/each}}
    </div>

    <div class="pagination">
        {{#if hasPrevPage}}
            <a href="{{prevLink}}" class="btn-page">Anterior</a>
        {{/if}}
        
        <span>Página {{page}} de {{totalPages}}</span>

        {{#if hasNextPage}}
            <a href="{{nextLink}}" class="btn-page">Siguiente</a>
        {{/if}}
    </div>
</div>

<script>
    async function addToCart(pid) {
        let cartId = localStorage.getItem('cartId');
        
        if (!cartId) {
            const response = await fetch('/api/carts', { method: 'POST' });
            const data = await response.json();
            cartId = data.payload._id;
            localStorage.setItem('cartId', cartId);
        }

        const addResponse = await fetch(`/api/carts/${cartId}/product/${pid}`, { method: 'POST' });
        const addData = await addResponse.json();
        
        if (addData.status === 'success') {
            alert('Producto agregado al carrito');
        } else {
            alert('Error al agregar el producto');
        }
    }
</script>
